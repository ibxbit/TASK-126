{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window and dynamically-spawned workspace windows.",
  "windows": [
    "main",
    "move_out_case:*",
    "parcel_queue:*",
    "claims_inbox:*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:tray:default",
    "global-shortcut:default"
  ]
}
